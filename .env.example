# Environment variables read by the API (src/solace/api/app.py). The code does not load .env files
# itself: export them in your shell or pass the file with `docker run --env-file .env`. Never commit .env.

# Intent parser for /v1/intent: "rule" (deterministic demo parser) or "hf" (LLM, needs .[llm] extra)
SOLACE_INTENT_PARSER=rule
# Hugging Face model id or local path used when SOLACE_INTENT_PARSER=hf
SOLACE_HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Optional path to a LoRA adapter produced by scripts/finetune_intent_lora.py
SOLACE_HF_ADAPTER=
# Gated models need a Hugging Face token in the environment (do not commit it)
# HF_TOKEN=
